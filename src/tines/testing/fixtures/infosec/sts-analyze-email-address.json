      "name": "Get Email Reputation",
      "disabled": false,
      "guid": "a225a191b89ee92b31f843fd26c1d78b",
      "options": {
        "url": "https://emailrep.io/{{.webhook_agent.emailaddress}}",
        "content_type": "json",
        "method": "get",
        "payload": {},

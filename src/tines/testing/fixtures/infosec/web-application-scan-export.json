      "name": "List Reports in Qualys",
      "disabled": false,
      "guid": "21465b06b5af1e4dde3d5e0e29139b0b",
      "options": {
        "url": "https://{{ .RESOURCE.qualys }}/qps/rest/3.0/search/was/finding/",
        "method": "post",
        "headers": {
          "Authorization": "Basic {{ .CREDENTIAL.qualys }}",
          "Host": "{{ .RESOURCE.qualys }}",
          "X-Requested-With": "Tines",
          "User-Agent": "Tines",
          "Content-Type": "application/xml"
        },
        "payload": "<ServiceRequest>\n    <filters>\n        <Criteria field=\"status\" operator=\"NOT EQUALS\">FIXED</Criteria>\n    </filters>\n    \n    <preferences>\n    {% if .list_reports_in_qualys.body.ServiceResponse.hasMoreRecords == \"true\"%}\n        <startFromId>{{ .list_reports_in_qualys.body.ServiceResponse.lastId}}</startFromId>\n    {% endif %}\n        <limitResults>10</limitResults>\n    </preferences>\n</ServiceRequest>"
      },

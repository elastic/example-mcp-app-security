  "agents": [
    {
      "type": "Agents::TriggerAgent",
      "name": "Trigger if knowngood",
      "disabled": false,
      "guid": "ee6e9074c9dd8aa32a64d89a353ad523",
      "options": {
        "rules": [
          {
            "type": "regex",
            "value": "true",
            "path": "{{.check_if_knowngood.rule_matched}}"
          }
        ]
      },
      "keep_events_for": 0
    },
    {
      "type": "Agents::EventTransformationAgent",
      "name": "Extract Domain",
      "disabled": false,
      "guid": "b8b20cb94aa1f755806c8bd080662563",
      "options": {
        "mode": "extract",
        "matchers": [
          {
            "path": "{{.receive_urls.body.url}}",
            "regexp": "^(?:https?:\\/\\/)?(?:[^@\\n]+@)?(?:www\\.)?([^:\\/\\n?]+)",
            "to": "domain"
          }
        ],
        "message": "This is an optional message"
      },
      "schedule": null,
      "keep_events_for": 0
    },
    {
      "type": "Agents::EventTransformationAgent",
      "name": "Delay Event",
      "disabled": false,
      "guid": "d5a418d0cb8920b9f6c7004dee5b024d",
      "options": {
        "mode": "delay",
        "seconds": "60"
      },
      "schedule": null,
      "keep_events_for": 0
    },
    {
      "type": "Agents::TriggerAgent",
      "name": "Trigger if Known Good by URLScan",
      "disabled": false,
      "guid": "26c75f5423cf7cd8af541961213d35de",
      "options": {
        "rules": [
          {
            "type": "regex",
            "value": "prevented",
            "path": "{{.submit_to_urlscan.body.message}}"
          }
        ]
      },
      "keep_events_for": 0
    },
    {
      "type": "Agents::EventTransformationAgent",
      "name": "Build Results",
      "disabled": false,
      "guid": "33fc22b63423bd180fc4fd8b64a58c7b",
      "options": {
        "mode": "message_only",
        "payload": {
          "url": "{{.receive_urls.body.url}}",
          "malicious": "false",
          "analysis_link": "knowngood",
          "analysis_date": "knowngood",
          "scan_engine": "knowngood",
          "page_screenshot": "knowngood",
          "screenshot": "{{.download_screenshot.body.base64encodedcontents}}"
        }
      },
      "schedule": null,
      "keep_events_for": 0
    },
    {
      "type": "Agents::WebhookAgent",
      "name": "Receive URLs",
      "disabled": false,
      "guid": "b1b7cba962fc9b1a9353a3d16f82cd74",
      "options": {
        "secret": "[REDACTED:secret]",
        "verbs": "get,post"

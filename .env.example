# Cluster configuration for the MCP server.
#
# Set CLUSTERS_JSON to a single-cluster JSON array, or point CLUSTERS_FILE
# at a JSON file with the same shape to keep secrets out of this file.
# CLUSTERS_FILE wins if both are set.

CLUSTERS_JSON=[{"name":"primary","elasticsearchUrl":"https://your-cluster.es.cloud.example.com","kibanaUrl":"https://your-cluster.kb.cloud.example.com","elasticsearchApiKey":"your-elasticsearch-api-key"}]

# Alternative: load the same JSON from a file.
# CLUSTERS_FILE=/absolute/path/to/clusters.json

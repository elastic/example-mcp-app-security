# Cluster configuration for the MCP server.
#
# Set CLUSTERS_JSON to a single-cluster JSON array, or point CLUSTERS_FILE
# at a JSON file with the same shape to keep secrets out of this file.
# CLUSTERS_FILE wins if both are set.

CLUSTERS_JSON=[{"name":"primary","elasticsearchUrl":"https://your-cluster.es.cloud.example.com","kibanaUrl":"https://your-cluster.kb.cloud.example.com","elasticsearchApiKey":"your-elasticsearch-api-key","sslVerify":true}]

# TLS verification options (per cluster, inside CLUSTERS_JSON / CLUSTERS_FILE):
#   sslVerify   — boolean, default true. Set false only for trusted self-signed dev clusters.
#   caCertPath  — absolute path to a PEM CA bundle file. Prefer this over sslVerify:false.
#                 Cannot be combined with sslVerify:false (rejected at startup).

# Alternative: load the same JSON from a file.
# CLUSTERS_FILE=/absolute/path/to/clusters.json

# Telemetry endpoint override. Defaults to production (telemetry.elastic.co).
# Set to `staging` to point at telemetry-staging.elastic.co — useful when
# verifying dashboards or working on the MCP App's analytics locally.
# See docs/telemetry.md for the full event catalog and opt-out story.
# MCP_APP_TELEMETRY_ENV=staging

# macOS Atomic emulation writes state and evidence locally. The tools reuse
# the default Elastic cluster above; no additional Elastic secret is needed.
MACOS_ATOMIC_RUNS_DIR=./macos-atomic-runs
# MACOS_ATOMIC_CACHE_DIR=./.macos-atomic-cache
MACOS_ATOMIC_ELASTIC_INDEX_ALLOWLIST=logs-*,filebeat-*,.alerts-security.alerts-*
MACOS_ATOMIC_RESULTS_INDEX=logs-atomic.results-default
MACOS_ATOMIC_DEFAULT_TIMEOUT_SECONDS=180
MACOS_ATOMIC_MAX_OUTPUT_BYTES=1048576

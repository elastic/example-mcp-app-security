{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "dist",
    "rootDir": ".",
    "lib": ["ES2022"]
  },
  "include": [
    "main.ts",
    "src/server.ts",
    "src/catalog/**/*",
    "src/execution/**/*",
    "src/elastic/**/*",
    "src/tools/**/*",
    "src/shared/json.ts",
    "src/shared/logger.ts",
    "src/shared/types.ts",
    "src/shared/validation.ts"
  ],
  "exclude": [
    "node_modules",
    "src/views/**/*",
    "src/test/**/*",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx"
  ]
}
